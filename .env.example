# Copy this file to `.env` and fill in the values for your own backend.
# These are read by the app's generated backend client. Never commit the real
# `.env` file — it is already listed in .gitignore.

# Server-side (used by the functions that talk to the database)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# Browser-side (exposed to the frontend, hence the VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref
